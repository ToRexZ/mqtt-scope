pkgbase = mqtt-scope-bin
	pkgdesc = Desktop MQTT client: live topic tree, large-message inspector, live plots and a publisher with saved messages
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/ToRexZ/mqtt-scope
	arch = x86_64
	license = MIT
	depends = alsa-lib
	depends = at-spi2-core
	depends = cairo
	depends = dbus
	depends = expat
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = libcups
	depends = libgcc
	depends = libx11
	depends = libxcb
	depends = libxcomposite
	depends = libxdamage
	depends = libxext
	depends = libxfixes
	depends = libxkbcommon
	depends = libxrandr
	depends = mesa
	depends = nspr
	depends = nss
	depends = pango
	depends = systemd-libs
	optdepends = libsecret: encrypt saved connection passwords with the system keyring
	optdepends = xdg-utils: open the data folder and log file from the menu
	provides = mqtt-scope
	conflicts = mqtt-scope
	options = !strip
	options = !debug
	source = mqtt-scope-0.2.0.tar.gz::https://github.com/ToRexZ/mqtt-scope/releases/download/v0.2.0/MQTT-Scope-0.2.0-linux-x64.tar.gz
	source = mqtt-scope-0.2.0-LICENSE::https://raw.githubusercontent.com/ToRexZ/mqtt-scope/v0.2.0/LICENSE
	source = mqtt-scope-0.2.0.svg::https://raw.githubusercontent.com/ToRexZ/mqtt-scope/v0.2.0/build/icon.svg
	source = mqtt-scope.desktop
